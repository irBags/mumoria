# Mumoria server settings. Copy to mumoria.conf (next to mumoria-server).
# Command-line --port and --db win over these.

port = 4000
db = mumoria.db

# Gold to found a guild.
guild_cost = 1000

# Shared gold in a party or guild run: each member gets
# (gold + (level - 1) x this) / members. 0.5 makes 12 gold between 5 worth
# 2.4 each on 50 ft, 2.5 on 100 ft, 2.6 on 150 ft.
party_gold_per_level = 0.5

# The stores' shared supply, in percent. At 100 the whole server can buy,
# per item and per 4 hours: 300 of anything worth up to 25 gold (food,
# torches, oil), 120 up to 100, 40 up to 500, 12 up to 2000, 4 above that.
# Each player's own stock is a single-player store's, back after an hour.
store_supply_percent = 100

# Mirror world chat to an IRC channel: the P3OL/AOL chat rooms are IRC, so
# members in that room talk with the players. Leave irc_host empty for none.
irc_host =
irc_port = 6667
irc_channel = #mumoria
irc_nick = Mumoria

# Shared with the P3OL server: it signs "name:expiry" so an AOL member logs
# in as their screen name without a password (type token:<token> at login).
aol_token_secret =

# Lua scripts: every *.lua here is loaded at start and on /reload
# (scripts/README.md is the guide).
scripts_dir = scripts
